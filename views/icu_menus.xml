    <!-- Clinical Notes -->
    <menuitem id="menu_icu_clinical_note"
              name="Clinical Notes"
              parent="menu_icu_root"
              action="action_icu_clinical_note"
              sequence="70"/>

    <!-- Discharge -->
    <menuitem id="menu_icu_discharge"
              name="Discharge"
              parent="menu_icu_root"
              action="action_icu_discharge"
              sequence="80"/>

    <!-- Reports -->
    <menuitem id="menu_icu_reports"
              name="Reports"
              parent="menu_icu_root"
              action="action_icu_reports"
              sequence="90"/>
</odoo>