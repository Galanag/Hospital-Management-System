<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_icu_bed_tree" model="ir.ui.view">
        <field name="name">hm.icu.bed.tree</field>
        <field name="model">hm.icu.bed</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room"/>
                <field name="is_isolation"/>
                <field name="state" widget="badge" decoration-success="state=='available'" decoration-danger="state=='occupied'"/>
                <field name="current_admission_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_icu_bed_form" model="ir.ui.view">
        <field name="name">hm.icu.bed.form</field>
        <field name="model">hm.icu.bed</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="room"/>
                        <field name="is_isolation"/>
                        <field name="state" widget="badge"/>
                        <field name="department_id"/>
                        <field name="current_admission_id" readonly="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View with filters for dashboard links -->
    <record id="view_icu_bed_search" model="ir.ui.view">
        <field name="name">hm.icu.bed.search</field>
        <field name="model">hm.icu.bed</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room"/>
                <filter name="occupied" string="Occupied" domain="[('state','=','occupied')]"/>
                <filter name="available" string="Available" domain="[('state','=','available')]"/>
                <separator/>
                <filter name="isolation" string="Isolation" domain="[('is_isolation','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_icu_bed" model="ir.actions.act_window">
        <field name="name">ICU Beds</field>
        <field name="res_model">hm.icu.bed</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_icu_bed_search"/>
    </record>
</odoo>