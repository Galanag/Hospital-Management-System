<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_icu_admission_tree" model="ir.ui.view">
        <field name="name">hm.icu.admission.tree</field>
        <field name="model">hm.icu.admission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="admission_date"/>
                <field name="bed_id"/>
                <field name="consultant_id"/>
                <field name="severity" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_icu_admission_form" model="ir.ui.view">
        <field name="name">hm.icu.admission.form</field>
        <field name="model">hm.icu.admission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_admit" type="object" string="Admit" class="btn-primary"/>
                    <button name="action_discharge" type="object" string="Discharge" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,admitted,discharged"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="patient_id" required="1"/>
                            <field name="admission_date"/>
                            <field name="bed_id" required="1" domain="[('state','=','available')]"/>
                        </group>
                        <group>
                            <field name="consultant_id"/>
                            <field name="severity" required="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="admission_diagnosis" required="1" widget="html"/>
                        <field name="notes" widget="html"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View – corrected -->
    <record id="view_icu_admission_search" model="ir.ui.view">
        <field name="name">hm.icu.admission.search</field>
        <field name="model">hm.icu.admission</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="name"/>
                <field name="consultant_id"/>
                <!-- Use date attribute for today's filter -->
                <filter name="admissions_today" string="Today" date="admission_date"/>
                <filter name="critical" string="Critical" domain="[('severity','=','critical')]"/>
                <filter name="admitted" string="Admitted" domain="[('state','=','admitted')]"/>
                <filter name="discharged" string="Discharged" domain="[('state','=','discharged')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_icu_admission" model="ir.actions.act_window">
        <field name="name">ICU Admissions</field>
        <field name="res_model">hm.icu.admission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_icu_admission_search"/>
    </record>
</odoo>