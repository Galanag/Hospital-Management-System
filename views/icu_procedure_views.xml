<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_icu_procedure_tree" model="ir.ui.view">
        <field name="name">hm.icu.procedure.tree</field>
        <field name="model">hm.icu.procedure</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="procedure_type" widget="badge"/>
                <field name="date_performed"/>
                <field name="performed_by"/>
            </list>
        </field>
    </record>

    <record id="view_icu_procedure_form" model="ir.ui.view">
        <field name="name">hm.icu.procedure.form</field>
        <field name="model">hm.icu.procedure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="patient_id" required="1"/>
                            <field name="admission_id"/>
                            <field name="procedure_type" required="1"/>
                        </group>
                        <group>
                            <field name="performed_by"/>
                            <field name="date_performed"/>
                        </group>
                        <field name="outcome" widget="html"/>
                        <field name="notes" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_icu_procedure" model="ir.actions.act_window">
        <field name="name">ICU Procedures</field>
        <field name="res_model">hm.icu.procedure</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>